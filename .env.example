# Copy these settings into .env and fill in your own key.
# Remote Buyer LLM (Modes 2-4) requires BOTH URL and model.
# If either is missing, Scenario evaluator falls back to local qwen3.5:4b.
DEEPSEEK_API_KEY=your-deepseek-api-key
CONVERGE_LLM_PROVIDER=deepseek
CONVERGE_LLM_BASE_URL=https://api.deepseek.com/v1
CONVERGE_LLM_MODEL=deepseek-chat
CONVERGE_LLM_BACKEND=remote
CONVERGE_USER_MODE=1
