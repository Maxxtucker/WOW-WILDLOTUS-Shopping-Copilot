# Persistent local NLU settings. Agent nlu mode and the NLU console load this file.
# PowerShell (current session only):  . .\scripts\load_nlu_env.ps1
# bash / zsh:                         source scripts/load_nlu_env.sh
# One-command demo:                   powershell -File scripts/setup.ps1
# Live probe (batch fixtures):        python scripts/nlu_probe.py --live
# Interactive understand NLU:         python scripts/nlu_console.py
# understand_mode=regex does not load this file.

AGENT_NLU_ENABLED=1
AGENT_NLU_MODEL=qwen3.5:4b
AGENT_NLU_HOST=http://127.0.0.1:11434
AGENT_NLU_TIMEOUT=60
