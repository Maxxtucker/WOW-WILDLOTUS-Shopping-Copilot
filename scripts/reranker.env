# off: deterministic catalog ranking only
# auto: use the local model when available, otherwise fall back safely
# required: fail the request if the reranker cannot load or infer
AGENT_RERANKER_MODE=auto
AGENT_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Keep competition runs offline and reproducible. Set to 0 only while
# deliberately downloading the model before evaluation.
AGENT_RERANKER_LOCAL_FILES_ONLY=1

# Rerank a small candidate head to control latency and memory.
AGENT_RERANKER_TOP_N=50
AGENT_RERANKER_BATCH_SIZE=8
AGENT_RERANKER_MAX_LENGTH=512

# Browsing benefits more from semantic fit; Buying keeps more weight on
# exact constraints, budget, BM25, rating, and popularity.
AGENT_RERANKER_BUYING_WEIGHT=0.35
AGENT_RERANKER_BROWSING_WEIGHT=0.55
AGENT_RERANKER_TEMPERATURE=0.20

# Optional examples:
# AGENT_RERANKER_DEVICE=cuda
# AGENT_RERANKER_REVISION=<pinned Hugging Face commit>
