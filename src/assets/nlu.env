# Persistent local NLU settings. Agent nlu mode and the NLU console load this file.
# Contest zip (this package as cwd):
#   PowerShell:  . .\load_nlu_env.ps1
#   bash / zsh:  source ./load_nlu_env.sh
#   one-command: powershell -ExecutionPolicy Bypass -File setup.ps1
#   console:     python nlu_console.py
# Kit checkout:  scripts/load_nlu_env.ps1 and scripts/setup.ps1 forward here.
# understand_mode=regex does not load this file.

AGENT_NLU_ENABLED=1
AGENT_NLU_MODEL=qwen3.5:4b
AGENT_NLU_HOST=http://127.0.0.1:11434
AGENT_NLU_TIMEOUT=60
